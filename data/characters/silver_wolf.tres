[resource]
script = ExtResource("1_character")
character_id = "silver_wolf"
display_name = "银狼"
role = "高速骇客"
description = "通过五维分配改变开局基础属性，以攻速爆发和位置回溯控制战斗节奏。"
unlocked_by_default = true
max_health = 99.0
max_energy = 99.0
move_speed = 99.0
attack_power = 99.0
defense_power = 99.0
energy_regeneration = 18.0
passive = "我的主场！：进入游戏时，你可分配你面板上的基础属性，每项属性的变动不高于20%。"
active = "二倍速：你的攻速提高99%且你的移速增加99点，持续9s。期间每次受到攻击，效果持续时间-2s且效果降低20%。持续时间结束时，若二倍速期间没有受到攻击，则回复期间消耗的能量，并使该技能剩余CD减少20%。\n\n幻影现实：记录发动技能时的位置和血量，然后传送至指定位置。传送落地时对周围一圈的敌人造成9（+9%攻击力）点伤害并击退敌人。在3s内再次发动技能会传送回记录的位置并将血量调整为记录的血量。若在3s内血量降为0，则立即触发二段技能，并使本技能下次CD延长99%。"
passive_skills = Array[Resource]([ExtResource("2_home_field")])
active_skills = Array[Resource]([ExtResource("3_double_speed"), ExtResource("4_phantom_reality")])
