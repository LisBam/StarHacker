[resource]
script = ExtResource("1_data")
skill_id = "caelus_stardust_ace"
display_name = "星尘王牌"
description = "进入“星尘王牌”状态。该状态下，你的每点护盾都能提供1点防御力，且你使用武器时，消耗所有护盾：若该武器来自近战武器槽，则对所有命中的敌人造成等同于50%消耗护盾值的伤害；若该武器来自远程武器槽，则对第一个命中的敌人造成等同于消耗护盾值的伤害。当你使用武器或释放技能的5s后，退出“星尘王牌”状态。"
behavior_script = ExtResource("2_behavior")
