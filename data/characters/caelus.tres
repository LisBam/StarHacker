[resource]
script = ExtResource("1_character")
character_id = "caelus"
display_name = "穹"
role = "防御型开拓者"
description = "以高生命与高防御承受正面压力，通过冲锋和拾荒收益强化近距离探索。"
unlocked_by_default = true
max_health = 120.0
